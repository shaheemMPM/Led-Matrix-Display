[Unit]
Description=Astral LED Matrix Clock
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/astral/Projects/Shaheem-Python-Test
ExecStart=/bin/bash /home/astral/Projects/Shaheem-Python-Test/astral_clock.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

